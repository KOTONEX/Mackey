      "mac": "⌘⇧N",
      "desc": "新建文件夹",
      "trigger": "Super-S-n",
      "targets": {
        "default": "C-S-n",
        "terminal": "C-S-n",
        "files": "C-S-n"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "new-tab",
      "mac": "⌘T",
      "desc": "新建标签页",
      "trigger": "Super-t",
      "targets": {
        "default": "C-t",
        "terminal": "C-S-t",
        "files": "C-t"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "reopen-tab",
      "mac": "⌘⇧T",
      "desc": "恢复关闭的标签页",
      "trigger": "Super-S-t",
      "targets": {
        "default": "C-S-t"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "close-tab",
      "mac": "⌘W",
      "desc": "关闭标签页/窗口",
      "trigger": "Super-w",
      "targets": {
        "default": "C-w",
        "terminal": "C-S-w",
        "files": "C-w"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "终端里 Ctrl+W 是删除前一个词，故用 Ctrl+Shift+W 关窗。"
    },
    {
      "id": "close-window",
      "mac": "⌘⇧W",
      "desc": "关闭窗口",
      "trigger": "Super-S-w",
      "targets": {
        "default": "C-S-w"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "quit",
      "mac": "⌘Q",
      "desc": "退出应用",
      "trigger": "Super-q",
      "targets": {},
      "status": "approx",
      "basis": "gnome",
      "policy": "passthrough",
      "conflict": "Super+Q 是 GNOME「关闭窗口」",
      "note": "语义天然对齐（macOS ⌘Q 也是退出），直接让 GNOME 处理，不接管。"

{
  "version": 1,
  "meta": {
    "name": "Mackey 行为清单",
    "note": "这是唯一事实源：tools/generate.py 依据它生成 xremap 配置与 docs/03-行为清单.md。",
    "legacy": [
      "C",
      "S",
      "A",
      "Super"
    ],
    "swallow_key": "F24",
    "basis_note": "basis 分类：macos = 本工具改写成 macOS 行为（policy translate/auto 且 targets 非空）；gnome = 保持 GNOME 默认（放行/原生等价/可选/无法模拟）。tools/generate.py 会校验 basis 与 policy/targets 是否一致。"
  },
  "profiles": {
    "terminal": {
      "label": "终端",
      "why": "终端里 Ctrl+C/Ctrl+Z/Ctrl+D 是信号或 EOF，绝不能被「复制/撤销/EOF」占用，必须单独一套。",
      "match": [
        "/^(org\\.gnome\\.Terminal|gnome-terminal-server|kgx|org\\.gnome\\.Console|Ptyxis|org\\.gnome\\.Ptyxis|alacritty|Alacritty|kitty|foot|footclient|wezterm|WezTerm|org\\.wezfurlong\\.wezterm|xterm|XTerm|uxterm|konsole|Konsole|st|st-256color|com\\.raggesilver\\.BlackBox|tilix|terminator|guake|tabby|Tabby|ghostty|com\\.mitchellh\\.ghostty|deepin-terminal|qterminal|QTerminal|mate-terminal|xfce4-terminal|Hyper|hyper)$/"
      ]
    },
    "files": {
      "label": "文件管理器",
      "why": "同一组键在文件管理器里语义不同（⌘⌫=移到废纸篓、⌘↑=上级目录、⌘I=显示简介）。",
      "match": [
        "/^(org\\.gnome\\.Nautilus|nautilus|Nautilus|org\\.gnome\\.Files|dolphin|Dolphin|thunar|Thunar|nemo|Nemo|org\\.nemo\\.Nemo|pcmanfm|pcmanfm-qt|krusader|caja|Caja|Files)$/"
      ]
    }
  },
  "relocations": [
    {
      "id": "app-grid",
      "schema": "org.gnome.shell.keybindings",
      "key": "toggle-application-view",
      "from": "Super-a",
      "to": "Super-A-a",
      "label": "显示应用网格",
      "triggered_by": "select-all"
    },
    {
      "id": "message-tray",
      "schema": "org.gnome.shell.keybindings",
      "key": "toggle-message-tray",
      "from": [
        "Super-v",
        "Super-m"
      ],
      "to": [
        "Super-A-v",
        "Super-A-m"
      ],
      "label": "通知/日历托盘",
      "triggered_by": "paste"
    },
    {
      "id": "quick-settings",
      "schema": "org.gnome.shell.keybindings",
      "key": "toggle-quick-settings",
      "from": "Super-s",
      "to": "Super-A-s",
      "label": "快速设置面板",
      "triggered_by": "save"
    },
    {
      "id": "show-desktop",
      "schema": "org.gnome.desktop.wm.keybindings",
      "key": "show-desktop",
      "from": "Super-d",
      "to": "Super-S-d",
      "label": "显示桌面",
      "triggered_by": "bookmark"
    },
    {
      "id": "notification",
      "schema": "org.gnome.shell.keybindings",
      "key": "focus-active-notification",
      "from": "Super-n",
      "to": "Super-A-n",
      "label": "聚焦通知",
      "triggered_by": "new"
    },
    {
      "id": "switch-monitor",
      "schema": "org.gnome.mutter.keybindings",
      "key": "switch-monitor",
      "from": "Super-p",
      "to": "Super-A-p",
      "label": "切换显示器",
      "triggered_by": "print"
    },
    {
      "id": "tile-left",
      "schema": "org.gnome.mutter.keybindings",
      "key": "toggle-tiled-left",
      "from": "Super-Left",
      "to": "Super-C-Left",
      "label": "左半屏平铺",
      "triggered_by": "line-start"
    },
    {
      "id": "tile-right",
      "schema": "org.gnome.mutter.keybindings",
      "key": "toggle-tiled-right",
      "from": "Super-Right",
      "to": "Super-C-Right",
      "label": "右半屏平铺",
      "triggered_by": "line-end"
    },
    {
      "id": "move-monitor",
      "schema": "org.gnome.desktop.wm.keybindings",
      "key": "move-to-monitor-left|move-to-monitor-right|move-to-monitor-up|move-to-monitor-down",
      "from": "Super-S-{D}",
      "to": "Super-C-S-{D}",
      "label": "窗口移到其他显示器",
      "triggered_by": "select-to-line-start"
    },
    {
      "id": "maximize",
      "schema": "org.gnome.desktop.wm.keybindings",
      "key": "maximize",
      "from": "Super-Up",
      "to": "Super-A-Up",
      "label": "最大化窗口",
      "triggered_by": "doc-start"
    },
    {
      "id": "unmaximize",
      "schema": "org.gnome.desktop.wm.keybindings",
      "key": "unmaximize",
      "from": "Super-Down",
      "to": "Super-A-Down",
      "label": "还原窗口",
      "triggered_by": "doc-end"
    },
    {
      "id": "dash-apps",
      "schema": "org.gnome.shell.keybindings",
      "key": "switch-to-application-1..9",
      "from": "Super-1..9",
      "to": "Super-C-S-1..9",
      "label": "程序坞第 N 个应用",
      "triggered_by": "tab-1..9"
    },
    {
      "id": "lock-screen",
      "schema": "org.gnome.settings-daemon.plugins.media-keys",
      "key": "screensaver",
      "from": "Super-l",
      "to": "Super-C-q",
      "label": "锁屏",
      "triggered_by": "location-bar"
    },
    {
      "id": "input-source",
      "schema": "org.gnome.desktop.wm.keybindings",
      "key": "switch-input-source",
      "from": [
        "Super-space",
        "Super-S-space"
      ],
      "to": [
        "Super-C-space",
        "Super-C-S-space"
      ],
      "label": "输入法/输入源切换",
      "triggered_by": "spotlight"
    }
  ],
  "entries": [
    {
      "id": "copy",
      "mac": "⌘C",
      "desc": "复制",
      "trigger": "Super-c",
      "targets": {
        "default": "C-c",
        "terminal": "C-S-c",
        "files": "C-c"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "终端必须走 Ctrl+Shift+C，否则触发 SIGINT。"
    },
    {
      "id": "paste",
      "mac": "⌘V",
      "desc": "粘贴",
      "trigger": "Super-v",
      "targets": {
        "default": "C-v",
        "terminal": "C-S-v",
        "files": "C-v"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "auto",
      "conflict": "Super+V 被 GNOME「通知托盘」占用",
      "relocate": "message-tray",
      "note": "默认策略=接管并把 GNOME 托盘功能平移到 ⌘⇧V。"
    },
    {
      "id": "paste-plain",
      "mac": "⌘⇧V",
      "desc": "粘贴为纯文本",
      "trigger": "Super-S-v",
      "targets": {
        "default": "C-S-v",
        "terminal": "C-S-v"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "GTK/Qt 应用普遍原生支持 Ctrl+Shift+V。macOS 的 ⌥⌘⇧V 变体未单独映射（Linux 侧 Ctrl+Shift+V 语义相同）。"
    },
    {
      "id": "cut",
      "mac": "⌘X",
      "desc": "剪切",
      "trigger": "Super-x",
      "targets": {
        "default": "C-x",
        "terminal": "C-S-x",
        "files": "C-x"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "终端里 Ctrl+Shift+X 一般不绑定，等于无害。"
    },
    {
      "id": "select-all",
      "mac": "⌘A",
      "desc": "全选",
      "trigger": "Super-a",
      "targets": {
        "default": "C-a",
        "terminal": "C-S-a",
        "files": "C-a"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "auto",
      "conflict": "Super+A 被 GNOME「应用网格」占用",
      "relocate": "app-grid",
      "note": "终端用 Ctrl+Shift+A（readline 的 Ctrl+A=行首 保持不变）。"
    },
    {
      "id": "undo",
      "mac": "⌘Z",
      "desc": "撤销",
      "trigger": "Super-z",
      "targets": {
        "default": "C-z",
        "terminal": "F24",
        "files": "C-z"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "终端里 Ctrl+Z 会 SIGTSTP 挂起前台进程，故吞掉（发射无害的 F24）。"
    },
    {
      "id": "redo",
      "mac": "⌘⇧Z",
      "desc": "重做",
      "trigger": "Super-S-z",
      "targets": {
        "default": "C-S-z",
        "terminal": "F24",
        "files": "C-S-z"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "少数应用（如 LibreOffice 系）用 Ctrl+Y 重做；要改的话在 config/checklist.json 里把 targets 改成 C-y 后重新生成。"
    },
    {
      "id": "save",
      "mac": "⌘S",
      "desc": "保存",
      "trigger": "Super-s",
      "targets": {
        "default": "C-s",
        "terminal": "C-S-s"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "auto",
      "conflict": "Super+S 被 GNOME「快速设置」占用",
      "relocate": "quick-settings",
      "note": "终端里 Ctrl+S 是 XOFF 流控，故走 Ctrl+Shift+S。"
    },
    {
      "id": "save-as",
      "mac": "⌘⇧S",
      "desc": "另存为",
      "trigger": "Super-S-s",
      "targets": {
        "default": "C-S-s",
        "terminal": "C-S-s"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "open",
      "mac": "⌘O",
      "desc": "打开",
      "trigger": "Super-o",
      "targets": {
        "default": "C-o",
        "terminal": "F24"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "终端里 Ctrl+O 会丢弃输出/取下一行，故吞掉。"
    },
    {
      "id": "print",
      "mac": "⌘P",
      "desc": "打印/打印预览",
      "trigger": "Super-p",
      "targets": {
        "default": "C-p",
        "terminal": "C-S-p"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "auto",
      "conflict": "Super+P 被 GNOME「切换显示器」占用",
      "relocate": "switch-monitor",
      "note": "硬件 XF86Display 键仍然可以直接切显示器。"
    },
    {
      "id": "find",
      "mac": "⌘F",
      "desc": "查找",
      "trigger": "Super-f",
      "targets": {
        "default": "C-f",
        "terminal": "C-S-f",
        "files": "C-f"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "find-next",
      "mac": "⌘G",
      "desc": "查找下一个",
      "trigger": "Super-g",
      "targets": {
        "default": "C-g",
        "terminal": "F24"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "终端里 Ctrl+G 是 readline abort，故吞掉。"
    },
    {
      "id": "find-prev",
      "mac": "⌘⇧G",
      "desc": "查找上一个",
      "trigger": "Super-S-g",
      "targets": {
        "default": "C-S-g",
        "terminal": "F24"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate"
    },
    {
      "id": "comment-toggle",
      "mac": "⌘/",
      "desc": "注释 / 取消注释",
      "trigger": "Super-slash",
      "targets": {
        "default": "C-slash"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "编辑器/IDE 通用（VS Code、JetBrains 等）；未绑定的应用里是无害空操作。"
    },
    {
      "id": "split-editor",
      "mac": "⌘\\",
      "desc": "拆分编辑器/分屏",
      "trigger": "Super-backslash",
      "targets": {
        "default": "C-backslash",
        "terminal": "F24"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "VS Code 等编辑器的「拆分编辑器」；终端里 Ctrl+\\ 是 SIGQUIT，故吞掉。"
    },
    {
      "id": "command-palette",
      "mac": "⌘⇧P",
      "desc": "命令面板",
      "trigger": "Super-S-p",
      "targets": {
        "default": "C-S-p"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "VS Code 等编辑器的命令面板；GNOME 的「切换显示器」已让路到 ⌥⌘P。"
    },
    {
      "id": "find-action",
      "mac": "⌘⇧A",
      "desc": "查找动作（Find Action）",
      "trigger": "Super-S-a",
      "targets": {
        "default": "C-S-a"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "JetBrains 系 IDE 的 Find Action；GNOME 的「应用网格」已让路到 ⌥⌘A。"
    },
    {
      "id": "devtools",
      "mac": "⌥⌘I",
      "desc": "开发者工具",
      "trigger": "Super-A-i",
      "targets": {
        "default": "C-S-i"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "浏览器 DevTools；macOS 上就是 ⌥⌘I。"
    },
    {
      "id": "devtools-console",
      "mac": "⌥⌘J",
      "desc": "开发者控制台",
      "trigger": "Super-A-j",
      "targets": {
        "default": "C-S-j"
      },
      "status": "mapped",
      "basis": "macos",
      "policy": "translate",
      "note": "浏览器 Console；macOS 上就是 ⌥⌘J。"
    },
    {
      "id": "new",
      "mac": "⌘N",

    {
      "id": "select-to-line-end",
      "mac": "⌘⇧→",
      "desc": "选中到行尾",
      "trigger": "Super-S-Right",
      "targets": {
        "default": "S-End"
      },
      "status": "relocated",
      "basis": "macos",
      "policy": "auto",
      "conflict": "Super+⇧→ 是 GNOME「窗口移到右侧显示器」",

#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Mackey contributors
#
# mackey —— 在 GNOME 上模拟 macOS 键位（面向 macOS + Linux 双持用户）
#
# 硬约束（设计前提，不是建议）：
#   1. 不写任何系统目录：所有落点都在 $HOME 下，写之前逐路径断言；
#      拒绝以 root/sudo 运行，也不调用 sudo。
#   2. 尽量不破坏 GNOME：只接管清单里明确列出的键；与 GNOME 冲突时，
#      优先「迁移 GNOME 功能」而不是「删掉 GNOME 功能」，且只在真的冲突时才动 dconf，
#      动之前备份、卸载时还原。
#
# 架构：
#   物理键盘 → xremap(evdev→uinput) → GNOME/应用
#                 ↑ 需要「按应用区分」时通过 socket 问 focusd
#                   focusd ← D-Bus ← gnome-shell 里的 xremap-compat 扩展
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UUID="xremap-compat@mackey.local"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mackey"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/mackey"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/mackey"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mackey"
EXT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/$UUID"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
LAUNCHER="$BIN_DIR/mackey"
BACKUP="$CONF_DIR/backup/gsettings.json"
ENGINE_BIN="$DATA_DIR/bin/xremap"
ENGINE_STATE="$STATE_DIR/engine.json"
SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mackey-focus.sock"

C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[2m'; C_END=$'\033[0m'
ok()   { printf '%s✓%s %s\n' "$C_OK" "$C_END" "$*"; }
warn() { printf '%s!%s %s\n' "$C_WARN" "$C_END" "$*"; }
err()  { printf '%s✗%s %s\n' "$C_ERR" "$C_END" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_END"; }
die()  { err "$*"; exit 1; }

# ---------------------------------------------------------------- 基础设施

guard_no_root() {
    [[ ${EUID:-$(id -u)} -eq 0 ]] && die "不要用 root/sudo 运行：本工具的立身之本就是不碰系统目录"
    return 0
}

# 「不污染系统目录」不是口号：每个写入点都要过这一关。
guard_home_path() {
    local path="$1"
    case "$path" in
        "$HOME"/*) return 0 ;;
        *) die "拒绝写入 $path：不在 \$HOME 下（违反「不污染系统目录」约束）" ;;
    esac
}

# systemd ExecStart 里的字面量参数：空格要引号；% 是说明符（写成 %%），
# $ 只对 ${VAR} 形式展开（写成 $$），" 与 \ 按 systemd 规则转义。
systemd_quote() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//%/%%}"
    s="${s//\$/\$\$}"
    printf '"%s"' "$s"
}

# 子脚本自己不做 $HOME 守卫。转发给它们的路径类参数在这里再守一遍，
# 防止 `mackey fetch-engine --dest /etc/x` / `--out-dir /etc/x` 绕过约束。
guard_forwarded_paths() {
    local opt val
    while (( $# )); do
        opt="$1"; shift
        case "$opt" in
            --dest|--cache|--state|--out-dir|--docs|--backup)
                val="${1:-}"
                [[ -n "$val" ]] || die "$opt 需要一个路径参数"
                guard_home_path "$val"
                ;;
            --dest=*|--cache=*|--state=*|--out-dir=*|--docs=*|--backup=*)
                guard_home_path "${opt#*=}"
                ;;
        esac
    done
    return 0
}

ensure_dir() {
    guard_home_path "$1"
    mkdir -p "$1"
}

user_config() {
    local key="$1" default="${2-}"
    [[ -f "$CONF_DIR/config.json" ]] || { printf '%s' "$default"; return; }
    python3 - "$CONF_DIR/config.json" "$key" "$default" <<'PY'
import json, sys
path, key, default = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    data = json.load(open(path, encoding="utf-8"))
except Exception:
    print(default, end="")
else:
    value = data.get(key, default)
    print(json.dumps(value, ensure_ascii=False) if isinstance(value, (dict, list)) else value, end="")
PY
}

session_env() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
}

find_engine() {
    local configured; configured="$(user_config engine '')"
    # MACKEY_ENGINE 是文档承诺的覆盖入口，优先级最高。
    for candidate in "${MACKEY_ENGINE:-}" "$configured" "$ENGINE_BIN" "$ROOT/.vendor/xremap" "$(command -v xremap 2>/dev/null || true)"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { printf '%s' "$candidate"; return 0; }
    done
    return 1
}

in_input_group() { id -nG 2>/dev/null | tr ' ' '\n' | grep -qx input; }

confirm() {
    [[ "${MACKEY_YES:-}" == "1" ]] && return 0
    local answer
    read -r -p "$1 [y/N] " answer
    [[ "$answer" == "y" || "$answer" == "Y" ]]
}

# ---------------------------------------------------------------- 子命令

cmd_init() {
    ensure_dir "$CONF_DIR"
    local probe layout suggestion
    probe="$(python3 "$ROOT/tools/detect-keyboard.py" 2>/dev/null)"
    local kbd vendor
    kbd="$(printf '%s' "$probe" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("name",""))' 2>/dev/null)"
    vendor="$(printf '%s' "$probe" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("vendor",""))' 2>/dev/null)"
    suggestion="$(printf '%s' "$probe" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("suggest_layout","pc-swap"))' 2>/dev/null)"
    [[ -z "$suggestion" ]] && suggestion="pc-swap"
    layout="$(user_config modifier_layout auto)"
    if [[ "$layout" == "auto" ]]; then
        layout="$suggestion"
        dim "（键盘：${kbd:-未知}，USB vendor=${vendor:-?} → modifier_layout=$layout）"
    fi
    python3 - "$CONF_DIR/config.json" "$layout" <<'PY'
import json, os, sys, time
path, layout = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(path):
    try:
        data = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError) as exc:
        backup = f"{path}.bak-{time.strftime('%Y%m%d%H%M%S')}"
        os.replace(path, backup)
        print(f"旧配置无法解析（{exc}），已备份到: {backup}", file=sys.stderr)
        data = {}
    if not isinstance(data, dict):
        backup = f"{path}.bak-{time.strftime('%Y%m%d%H%M%S')}"
        os.replace(path, backup)
        print(f"旧配置不是 JSON 对象，已备份到: {backup}", file=sys.stderr)
        data = {}
data.setdefault("modifier_layout", layout)
data.setdefault("_modifier_layout_说明",
    "apple = ⌘ 就是 Super 键（Apple 键盘或机械键盘的 Mac 模式）；"
    "pc-swap = 把物理 Alt/Win 交换，让空格旁那颗键变成 ⌘（PC 配列键盘）")
data.setdefault("device", {})
data.setdefault("_device_说明", '只重映射指定键盘，例如 {"only": ["MX Keys"]}；留空=全部键盘')
data.setdefault("keypress_delay_ms", 0)
data.setdefault("_keypress_delay_ms_说明", "Wayland 下个别应用对合成按键不敏感时，可设 20 试试")
data.setdefault("engine", "")
data.setdefault("_engine_说明", "自定义 xremap 路径；留空=用 XDG 数据目录里下载的引擎")

# 固定键序：保证「重装 / 干净安装」写出的 config.json 逐字节一致（幂等）。
order = ["modifier_layout", "_modifier_layout_说明", "device", "_device_说明",
         "keypress_delay_ms", "_keypress_delay_ms_说明", "engine", "_engine_说明"]
ordered = {k: data[k] for k in order if k in data}
ordered.update({k: v for k, v in data.items() if k not in ordered})
json.dump(ordered, open(path, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print("配置写入:", path)
PY
    ok "初始化完成"
    # 运行时命令不重写仓库里的 docs/03（那是 make generate / mackey generate 的职责），
    # 并显式传路径，避免 generate.py 的默认值与 XDG_CONFIG_HOME 分叉。
    python3 "$ROOT/tools/generate.py" --no-docs \
        --user-config "$CONF_DIR/config.json" --out-dir "$CONF_DIR" --backup "$BACKUP" >/dev/null \
        || die "生成 xremap 配置失败（见上面的报错）"
    ok "已生成 $CONF_DIR/xremap.json"
}

cmd_fetch_engine() {
    session_env
    guard_home_path "$ENGINE_BIN"
    guard_home_path "$CACHE_DIR"
    guard_forwarded_paths "$@"
    guard_home_path "$ENGINE_STATE"
    ensure_dir "$(dirname "$ENGINE_BIN")"
    local args=(--dest "$ENGINE_BIN" --cache "$CACHE_DIR" --state "$ENGINE_STATE")
    [[ -n "${MACKEY_ENGINE_TAG:-}" ]] && args+=(--tag "$MACKEY_ENGINE_TAG")
    python3 "$ROOT/tools/fetch-engine.py" "${args[@]}" "$@"
}

# 生成/刷新引擎服务单元（install 与 enable 共用）。
# 返回 0 = 已写入；1 = 没有可用引擎（顺带移除陈旧单元）。
# 注意：不能给用户服务写 SupplementaryGroups=input。systemd 用户管理器没有
# CAP_SETGID（systemd 261 实测 CapEff 里没有），带该指令的 unit 一定会
# 216/GROUP「Changing group credentials failed」，连重启循环都进不去；
# 而用户服务本来就继承会话的附加组，重登后 input 组自然可用。
write_engine_unit() {
    local engine engine_unit device_args device_only exec_line name
    engine_unit="$UNIT_DIR/mackey-engine.service"
    # 先守卫再动文件：下面的 rm -f 也属于「写」，不能绕过约束。
    guard_home_path "$engine_unit"
    engine="$(find_engine || true)"
    if [[ -z "$engine" ]]; then
        # 没有引擎时不能留下上一版的引擎 unit（它指向已不存在的二进制），
        # 否则重装结果与干净安装不一致，enable 还会去启动一个坏服务。
        if [[ -f "$engine_unit" ]]; then
            rm -f "$engine_unit"
            ok "已移除陈旧的 mackey-engine.service（当前没有可用引擎）"
        fi
        warn "没找到 xremap，跳过引擎服务；装好后运行 mackey install 重来"
        dim "  获取引擎：mackey fetch-engine  或  cargo install xremap --features gnome  或放一份到 $ROOT/.vendor/xremap"
        return 1
    fi

    # xremap 的 --device 一次只接一个设备名，名字里可能有空格（如 "MX Keys"）。
    # 旧实现把多个名字用空格 join 后直接拼进 ExecStart：两个设备名或带空格的名字
    # 都会被 systemd/xremap 拆坏参数，引擎直接起不来（Restart=always 还会刷日志）。
    device_args=""
    device_only="$(user_config device '{}')"
    if [[ "$device_only" != "{}" ]]; then
        while IFS= read -r name; do
            [[ -n "$name" ]] && device_args+="--device $(systemd_quote "$name") "
        done < <(python3 -c '
import json,sys
d=json.loads(sys.argv[1])
print("\n".join(d.get("only", [])))' "$device_only")
    fi

    exec_line="$(systemd_quote "$engine")"
    [[ -n "$device_args" ]] && exec_line="$exec_line $device_args"
    exec_line="$exec_line $(systemd_quote "$CONF_DIR/xremap.json")"

    ensure_dir "$UNIT_DIR"
    cat > "$engine_unit" <<EOF
[Unit]
Description=Mackey 键位引擎（xremap）
After=mackey-focusd.service
Wants=mackey-focusd.service

[Service]
Type=simple
Environment=GNOME_SOCKET=%t/mackey-focus.sock
ExecStart=$exec_line
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF
    [[ -s "$engine_unit" ]] || { err "写入 $engine_unit 失败"; return 1; }
    ok "已写入 mackey-engine.service（引擎：$engine）"
    if ! in_input_group; then
        warn "当前会话没有 input 组，服务可能读不到 /dev/input：先执行 sudo usermod -aG input \$(id -un) 并重新登录"
    fi
    return 0
}

cmd_install() {
    guard_no_root
    session_env
    local fetch_engine=1 keep_running=0 arg
    for arg in "$@"; do
        case "$arg" in
            --no-fetch) fetch_engine=0 ;;
            --keep-running) keep_running=1 ;;
            *) warn "install 忽略未知参数：$arg" ;;
        esac
    done
    if [[ $fetch_engine -eq 1 ]]; then
        cmd_fetch_engine || warn "引擎下载失败；继续安装扩展与服务（本机已有 xremap 时会直接使用）"
    fi
    ensure_dir "$CONF_DIR"
    ensure_dir "$DATA_DIR"
    ensure_dir "$UNIT_DIR"

    # 先收敛到「干净安装」的基线：不在跑的旧服务、没有自启软链、没有陈旧 socket。
    # 否则重装后旧进程仍持有旧文件，enable 状态也会残留，结果与全新安装不同。
    if [[ $keep_running -eq 0 ]]; then
        systemctl --user disable --now mackey-focusd.service mackey-engine.service 2>/dev/null || true
        systemctl --user reset-failed mackey-focusd.service mackey-engine.service 2>/dev/null || true
        rm -f "$UNIT_DIR/default.target.wants/mackey-focusd.service" \
              "$UNIT_DIR/default.target.wants/mackey-engine.service"
        rm -f "$SOCKET" 2>/dev/null || true
    fi

    # 1) 扩展
    guard_home_path "$EXT_DIR"
    ensure_dir "$(dirname "$EXT_DIR")"
    [[ -d "$ROOT/extension/$UUID" ]] || die "扩展源目录不存在：$ROOT/extension/$UUID"
    rm -rf "$EXT_DIR"
    cp -r "$ROOT/extension/$UUID" "$EXT_DIR" || die "扩展安装失败：$ROOT/extension/$UUID → $EXT_DIR"
    ok "扩展已安装：$EXT_DIR"

    # 2) 焦点桥 + 引擎的用户服务
    local focusd_unit engine_unit
    focusd_unit="$UNIT_DIR/mackey-focusd.service"
    engine_unit="$UNIT_DIR/mackey-engine.service"
    guard_home_path "$focusd_unit"
    guard_home_path "$engine_unit"
    local py
    py="$(command -v python3)"
    cat > "$focusd_unit" <<EOF
[Unit]
Description=Mackey 焦点上报桥（为 xremap 提供 GNOME Wayland 焦点应用）

[Service]
Type=simple
ExecStart=$py $ROOT/tools/focusd.py --socket %t/mackey-focus.sock
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF
    [[ -s "$focusd_unit" ]] || die "写入 $focusd_unit 失败"
    ok "已安装 mackey-focusd.service"

    write_engine_unit || true

    systemctl --user daemon-reload 2>/dev/null || true
    ok "systemctl --user daemon-reload 完成"

    # 3) 命令行入口（$XDG_BIN_HOME，默认 ~/.local/bin），指向本仓库
    guard_home_path "$LAUNCHER"
    ensure_dir "$BIN_DIR"
    # 与 uninstall 对称：不是本仓库装的同名入口先备份，不静默覆盖别人的文件
    if [[ -e "$LAUNCHER" ]] && ! grep -qF "$ROOT/bin/mackey" "$LAUNCHER" 2>/dev/null; then
        local launcher_bak
        launcher_bak="$LAUNCHER.bak-$(date +%Y%m%d%H%M%S)"
        mv "$LAUNCHER" "$launcher_bak"
        warn "已存在同名入口且不属于本仓库，已备份到 $launcher_bak"
    fi
    cat > "$LAUNCHER" <<EOF
#!/usr/bin/env bash
# mackey 命令行入口（由 mackey install 生成，指向仓库：$ROOT）
exec "$ROOT/bin/mackey" "\$@"
EOF
    chmod +x "$LAUNCHER"
    ok "命令行入口已安装：$LAUNCHER"
    case ":$PATH:" in
        *":$BIN_DIR:"*) ;;
        *) warn "$BIN_DIR 不在 PATH 里：fish 用户执行 fish_add_path $BIN_DIR，bash 用户把它加进 ~/.bashrc" ;;
    esac
    cat <<EOF

下一步：
  1) 让 GNOME 加载新扩展（Wayland 下新装的扩展必须重新登录才会被扫描到）：
       ${C_DIM}注销 → 重新登录${C_END}
  2) 重新登录后执行：  mackey doctor && mackey enable
EOF
}

cmd_uninstall() {
    guard_no_root
    session_env
    local purge=0 dry=0 arg
    for arg in "$@"; do
        case "$arg" in
            --purge) purge=1 ;;
            --dry-run) dry=1 ;;
            -y|--yes) MACKEY_YES=1 ;;
            *) warn "uninstall 忽略未知参数：$arg" ;;
        esac
    done

    local targets=(
        "$UNIT_DIR/mackey-focusd.service" "$UNIT_DIR/mackey-engine.service"
        "$UNIT_DIR/default.target.wants/mackey-focusd.service"
        "$UNIT_DIR/default.target.wants/mackey-engine.service"
        "$LAUNCHER"
        "$EXT_DIR" "$DATA_DIR" "$CACHE_DIR" "$STATE_DIR" "$SOCKET"
    )
    [[ $purge -eq 1 ]] && targets+=("$CONF_DIR")

    if [[ $dry -eq 1 ]]; then
        dim "（--dry-run：只列出将要清理的内容，不做任何改动）"
        local t
        for t in "${targets[@]}"; do
            if [[ ! -e "$t" && ! -L "$t" ]]; then
                dim "不存在：$t"
            elif [[ "$t" == "$LAUNCHER" ]] && ! grep -qF "$ROOT/bin/mackey" "$t" 2>/dev/null; then
                warn "会跳过（不是本仓库装的入口）：$t"
            else
                ok "会删除：$t"
            fi
        done
        dim "会执行：systemctl --user disable --now mackey-focusd.service mackey-engine.service"
        dim "会执行：还原 GNOME 键位（$BACKUP）并摘除扩展启用状态（org.gnome.shell enabled-extensions）"
        return 0
    fi

    guard_home_path "$EXT_DIR"
    guard_home_path "$UNIT_DIR"
    guard_home_path "$DATA_DIR"
    guard_home_path "$CACHE_DIR"
    guard_home_path "$STATE_DIR"
    guard_home_path "$LAUNCHER"
    confirm "卸载会：停用服务、还原 GNOME 键位、删除扩展与引擎（$ENGINE_BIN），继续？" || { dim "已取消"; return 0; }
    if [[ $purge -eq 1 ]]; then
        confirm "同时删除配置、备份与缓存（$CONF_DIR 等）？" || { dim "保留配置，继续卸载其他内容"; purge=0; }
    fi

    systemctl --user disable --now mackey-focusd.service mackey-engine.service 2>/dev/null || true
    rm -f "$UNIT_DIR/mackey-focusd.service" "$UNIT_DIR/mackey-engine.service"
    rm -f "$UNIT_DIR/default.target.wants/mackey-focusd.service" \
          "$UNIT_DIR/default.target.wants/mackey-engine.service"
    systemctl --user daemon-reload 2>/dev/null || true
    ok "服务已移除"

    rm -rf "$EXT_DIR"
    cmd_forget_extension
    ok "扩展已删除"

    # 只删除确实指向本仓库的入口，避免误删别人的同名文件
    if [[ -f "$LAUNCHER" ]] && grep -qF "$ROOT/bin/mackey" "$LAUNCHER"; then
        rm -f "$LAUNCHER"
        ok "命令行入口已移除：$LAUNCHER"
    fi

    local revert_ok=1
    cmd_revert_gsettings || revert_ok=0

    rm -rf "$DATA_DIR" "$CACHE_DIR" "$STATE_DIR"
    rm -f "$SOCKET" 2>/dev/null || true
    ok "引擎、缓存与状态已清理"

    if [[ $purge -eq 1 && $revert_ok -eq 1 ]]; then
        rm -rf "$CONF_DIR"
        ok "配置与备份已删除"
    else
        dim "配置保留在 $CONF_DIR（彻底清理：mackey uninstall --purge）"
    fi
    if [[ $revert_ok -eq 0 ]]; then
        err "GNOME 键位未完全还原；备份已保留（$BACKUP），修好后重试 mackey revert"
        return 1
    fi
    ok "卸载完成（GNOME 侧可能需要重新登录才会彻底消失）"
}

# 扩展被 enable 后，UUID 会写进 org.gnome.shell enabled-extensions；
# 只删目录而不摘这项，GNOME 侧仍留着一条指向不存在扩展的记录。
cmd_forget_extension() {
    command -v gsettings >/dev/null 2>&1 || return 0
    python3 - "$UUID" <<'PY'
import re
import subprocess
import sys

uuid = sys.argv[1]
for schema_key in ("org.gnome.shell enabled-extensions",
                   "org.gnome.shell disabled-extensions"):
    schema, key = schema_key.split(" ", 1)
    try:
        raw = subprocess.run(["gsettings", "get", schema, key],
                             capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        continue
    items = re.findall(r"'([^']*)'", raw)
    if uuid not in items:
        continue
    items = [i for i in items if i != uuid]
    value = "[" + ", ".join(f"'{i}'" for i in items) + "]"
    subprocess.run(["gsettings", "set", schema, key, value], check=False)
PY
}

cmd_enable() {
    session_env

    # 安全闸门 1：先测焦点来源（不依赖服务）。
    # 焦点来源不可用时绝不能开引擎：xremap 会打印 supported: false，
    # application 过滤静默失效，终端里的 ⌘C 会变成 Ctrl+C（SIGINT，杀掉前台进程）。
    # 同时也不启动焦点桥服务——没有来源时它只会崩溃重启、刷 journal。
    if ! python3 "$ROOT/tools/focusd.py" --test >/dev/null 2>&1; then
        err "焦点来源不可用，已拒绝启动焦点桥与引擎（这是保护，不是故障）"
        dim "  原因：无法读到当前焦点应用 → xremap 的按应用分流会失效 →"
        dim "  终端里的 ⌘C 会退化成 Ctrl+C（SIGINT，杀掉正在跑的进程）。"
        dim "  处理：重新登录让 xremap-compat 扩展被 GNOME 加载（Wayland 下新扩展必须重登），"
        dim "  或启用任意焦点上报扩展（如 focused-window-dbus）。然后 mackey doctor 应为绿色。"
        systemctl --user disable --now mackey-focusd.service mackey-engine.service 2>/dev/null || true
        cmd_status
        return 1
    fi
    ok "焦点来源可用：$(python3 "$ROOT/tools/focusd.py" --test 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin)["wm_class"] or "(空)")' 2>/dev/null)"

    systemctl --user enable --now mackey-focusd.service 2>&1 | tail -2
    sleep 2
    if systemctl --user is-active --quiet mackey-focusd.service; then
        ok "焦点桥服务：运行中"
    else
        warn "焦点桥服务没起来，看 mackey logs"
    fi
    gnome-extensions enable "$UUID" 2>/dev/null && ok "扩展已启用" || warn "扩展启用失败（可能还没重新登录过）"

    # 安全闸门 2：input 组没在当前会话生效时，引擎读不到 /dev/input，
    # 启动只会崩溃重启（journal 里刷 "No input devices"）。不如明确拒绝并给出下一步。
    if ! in_input_group; then
        err "当前会话没有 input 组：引擎读不到 /dev/input，已拒绝启动（这是保护，不是故障）"
        dim "  处理：sudo usermod -aG input \$(id -un)，然后重新登录本会话；"
        dim "  重登后再执行 mackey enable —— 届时服务会随会话继承 input 组并启动。"
        systemctl --user disable --now mackey-engine.service 2>/dev/null || true
        cmd_status
        return 1
    fi

    # 会话已拿到 input 组：刷新 unit 后启动（用户服务自动继承会话的附加组）
    write_engine_unit >/dev/null || true
    systemctl --user daemon-reload 2>/dev/null || true
    if systemctl --user list-unit-files 2>/dev/null | grep -q mackey-engine; then
        systemctl --user enable --now mackey-engine.service 2>&1 | tail -2
        sleep 2
        if ! systemctl --user is-active --quiet mackey-engine.service; then
            warn "引擎服务没起来，看 mackey logs 50"
        fi
    fi
    cmd_status
}

cmd_disable() {
    session_env
    systemctl --user disable --now mackey-focusd.service mackey-engine.service 2>/dev/null || true
    ok "服务已停用（键盘立即恢复 Linux 原生行为）"
}

cmd_status() {
    session_env
    echo "── Mackey 状态 ────────────────────────────────────────"
    local sid stype
    sid="$(loginctl 2>/dev/null | awk -v u="$(id -un)" '$3==u && $6=="user" {print $1; exit}')"
    stype="$(loginctl show-session "${sid:-0}" -p Type --value 2>/dev/null)"
    printf '会话        : %s\n' "${stype:-未知}"
    printf 'GNOME Shell : %s\n' "$(gnome-shell --version 2>/dev/null | awk '{print $3}')"
    printf '配置布局    : %s\n' "$(user_config modifier_layout auto)"
    local engine; engine="$(find_engine || true)"
    if [[ -n "$engine" ]]; then
        printf '引擎        : %s\n' "$engine"
        if [[ -f "$ENGINE_STATE" ]]; then
            dim "  来源      : $(python3 -c 'import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8")); print(d.get("tag","?"), "/", d.get("feature","?"), "/", d.get("asset","?"))' "$ENGINE_STATE" 2>/dev/null)"
        fi
    else
        printf '引擎        : (未找到；可运行 mackey fetch-engine)\n'
    fi

    if systemctl --user is-active --quiet mackey-focusd.service 2>/dev/null; then
        ok "focusd 服务：运行中（$(python3 "$ROOT/tools/focusd.py" --test 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print("焦点="+(d["wm_class"] or "空"))' 2>/dev/null)）"
    else
        warn "focusd 服务：未运行"
    fi
    if systemctl --user is-active --quiet mackey-engine.service 2>/dev/null; then
        ok "引擎服务：运行中"
    else
        warn "引擎服务：未运行（按键行为 = Linux 原生）"
    fi
    if [[ -d "$EXT_DIR" ]]; then
        local state; state="$(LC_ALL=C gnome-extensions info "$UUID" 2>/dev/null | awk -F': ' '/State/{print $2}')"
        if [[ "$state" == "ACTIVE" ]]; then ok "扩展：ACTIVE"; else warn "扩展：${state:-未加载}"; fi
    else
        warn "扩展：未安装"
    fi
    echo "─────────────────────────────────────────────────────────"
}

cmd_probe() {
    session_env
    python3 "$ROOT/tools/generate.py" --report \
        --user-config "$CONF_DIR/config.json" --out-dir "$CONF_DIR" --backup "$BACKUP"
}

cmd_doctor() {
    guard_no_root
    session_env
    local problems=0
    echo "── Mackey 体检 ────────────────────────────────────────"

    # 0) 会话
    local stype; stype="$(loginctl show-session "$(loginctl 2>/dev/null | awk -v u="$(id -un)" '$3==u && $6=="user" {print $1; exit}')" -p Type --value 2>/dev/null)"
    [[ "$stype" == "wayland" ]] && ok "会话类型：Wayland（走 evdev 方案，正确）" \
        || { dim "会话类型：${stype:-未知}（X11 下本方案同样可用）"; }

    # 1) 读输入设备的权限（evdev 方案的唯一特权前提）
    if in_input_group; then        ok "input 组：当前会话已生效"
    elif getent group input 2>/dev/null | grep -q "\b$(id -un)\b"; then
        warn "input 组：已在 /etc/group 里，但当前会话没生效 → 需要重新登录（新组在登录时才注入进程）"
        problems=$((problems+1))
    else
        err "input 组：未加入。执行 sudo usermod -aG input \$(id -un) 后重新登录（这是读 /dev/input 的唯一办法）"
        dim "  注：加入 input 组意味着「任何以你身份运行的进程都能读键盘」，这是该方案的既定代价。"
        problems=$((problems+1))
    fi
    if [[ -w /dev/uinput ]]; then ok "/dev/uinput：可写（合成按键所需）"; else
        err "/dev/uinput：不可写。需要一条 udev 规则（会写 /etc，属系统目录改动）或发行版预置："
        dim "  echo 'KERNEL==\"uinput\", GROUP=\"input\", TAG+=\"uaccess\", MODE=\"0660\", OPTIONS+=\"static_node=uinput\"' | sudo tee /etc/udev/rules.d/99-uinput.rules"
        problems=$((problems+1))
    fi

    # 2) 引擎
    local engine; engine="$(find_engine || true)"
    if [[ -n "$engine" ]]; then
        ok "引擎：$engine"
        local ver; ver="$("$engine" --version 2>&1 | head -1)"
        [[ -n "$ver" ]] && dim "  $ver"
    else
        err "引擎：没找到 xremap（可运行 mackey fetch-engine 自动下载，或 cargo install xremap --features gnome / 放一份到 $ROOT/.vendor/xremap）"
        problems=$((problems+1))
    fi

    # 3) 命令行入口 + 扩展 + 焦点桥（决定「终端 vs 应用」能不能区分）
    if command -v mackey >/dev/null 2>&1; then
        ok "命令行入口：$(command -v mackey)"
    else
        warn "命令行入口：PATH 里没有 mackey（可直接用 $ROOT/bin/mackey；install 会装到 $LAUNCHER）"
    fi

    # 4) 扩展 + 焦点桥（决定「终端 vs 应用」能不能区分）
    if [[ -d "$EXT_DIR" ]]; then
        local state; state="$(LC_ALL=C gnome-extensions info "$UUID" 2>/dev/null | awk -F': ' '/State/{print $2}')"
        [[ "$state" == "ACTIVE" ]] && ok "扩展 xremap-compat：ACTIVE" \
            || { warn "扩展 xremap-compat：$state（新装扩展需要重新登录才会被 GNOME 扫描到）"; problems=$((problems+1)); }
    else
        warn "扩展未安装：先 mackey install，再重新登录"
        problems=$((problems+1))
    fi
    local focus_out
    if focus_out="$(python3 "$ROOT/tools/focusd.py" --test 2>/dev/null)" && [[ -n "$focus_out" ]]; then
        ok "焦点来源：$(printf '%s' "$focus_out" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("wm_class") or "(空)")')"
    elif python3 "$ROOT/tools/focusd.py" --test --backend focused-window >/dev/null 2>&1; then
        ok "焦点来源：第三方焦点扩展可用（xremap-compat 未加载也不影响）"
    else
        err "焦点来源：不可用 → xremap 会打印 supported: false，终端特殊映射全部失效（⌘C 会变成 SIGINT！）"
        problems=$((problems+1))
    fi

    # 4) 冲突与迁移（探测失败必须显式说出来，不能显示成「0 条冲突」）
    local need nbackup report
    if ! report=$(python3 "$ROOT/tools/generate.py" --report \
            --user-config "$CONF_DIR/config.json" --out-dir "$CONF_DIR" --backup "$BACKUP" 2>&1); then
        warn "GNOME 键位探测失败，冲突数未知：$(printf '%s' "$report" | grep -E '✗|失败' | head -1)"
        problems=$((problems+1))
    fi
    need=$(printf '%s' "$report" | grep -oE '需要迁移 GNOME 键位 [0-9]+ 条' | grep -oE '[0-9]+' | head -1)
    need="${need:-0}"
    dim "GNOME 键位冲突：本机需要迁移 $need 条"
    if [[ -f "$BACKUP" ]]; then
        nbackup=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1], encoding="utf-8"))))' "$BACKUP" 2>/dev/null || echo 0)
        ok "键位备份：$BACKUP（$nbackup 条，revert/uninstall 会还原）"
    else
        dim "尚未改动任何 GNOME 键位（未备份）"
    fi

    # 5) 历史遗留（例如之前用别的方案留下的失败服务）
    if journalctl -b --no-pager -n 500 2>/dev/null | grep -q 'gnome-macos-remap'; then
        warn "检测到历史遗留的 gnome-macos-remap.service 仍在反复启动失败："
        dim "  journalctl -b | grep gnome-macos-remap ；找到后用 systemctl --user disable --now gnome-macos-remap 清掉"
    fi

    echo "─────────────────────────────────────────────────────────"
    [[ $problems -eq 0 ]] && ok "没有发现问题" || warn "$problems 项待处理"
    return 0
}

cmd_apply() {
    guard_no_root
    session_env
    # 显式传路径：与 CONF_DIR/BACKUP 保持一致（XDG_CONFIG_HOME 下不再分叉）
    local gen_args=(--no-docs --user-config "$CONF_DIR/config.json" --out-dir "$CONF_DIR" --backup "$BACKUP")
    python3 "$ROOT/tools/generate.py" "${gen_args[@]}" || die "生成失败"
    local plan="$CONF_DIR/relocations.json" n
    n="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1], encoding="utf-8"))))' "$plan" 2>/dev/null)" \
        || die "无法解析迁移计划：$plan（重新 mackey generate 后再试）"
    if [[ "$n" -gt 0 ]]; then
        if confirm "要把 $n 条 GNOME 键位迁移到新组合（会写入用户 dconf，可还原）？"; then
            ensure_dir "$(dirname "$BACKUP")"
            python3 - "$plan" "$BACKUP" <<'PY' || die "GNOME 键位迁移失败；已改动的键位可执行 mackey revert 还原"
import json, os, subprocess, sys, tempfile
plan = json.load(open(sys.argv[1], encoding="utf-8"))
backup_path = sys.argv[2]
backup = json.load(open(backup_path, encoding="utf-8")) if os.path.exists(backup_path) else {}

# 先把所有旧值合并进备份并原子落盘，再改 dconf：
# 中途失败时 revert 至少能覆盖到已经改过的键位（旧实现是改完才写备份）。
for item in plan:
    backup.setdefault(f"{item['schema']} {item['key']}", item["old"])
tmp = tempfile.NamedTemporaryFile("w", encoding="utf-8",
                                  dir=os.path.dirname(backup_path) or ".",
                                  delete=False)
json.dump(backup, tmp, ensure_ascii=False, indent=2)
tmp.flush(); os.fsync(tmp.fileno()); tmp.close()
os.replace(tmp.name, backup_path)

failed = []
for item in plan:
    value = "[" + ", ".join("'%s'" % a for a in item["new"]) + "]"
    rc = subprocess.run(["gsettings", "set", item["schema"], item["key"], value], check=False).returncode
    if rc != 0:
        failed.append(f"{item['schema']} {item['key']}")
if failed:
    print("✗ 以下键位迁移失败：" + "、".join(failed), file=sys.stderr)
    print(f"  备份已提前保存在 {backup_path}，可用 mackey revert 还原", file=sys.stderr)
    sys.exit(1)
print(f"已迁移 {len(plan)} 条 GNOME 键位；原值备份在 {backup_path}")
PY
            ok "GNOME 键位迁移完成"
        fi
    else
        dim "本机没有需要迁移的 GNOME 键位"
    fi
    cmd_enable
}

cmd_revert_gsettings() {
    [[ -f "$BACKUP" ]] || { dim "没有备份，无需还原"; return 0; }
    local rc=0
    python3 - "$BACKUP" <<'PY' || rc=$?
import json, subprocess, sys
backup = json.load(open(sys.argv[1], encoding="utf-8"))
failed = []
for ident, accels in backup.items():
    schema, key = ident.split(" ", 1)
    value = "[" + ", ".join("'%s'" % a for a in accels) + "]"
    if subprocess.run(["gsettings", "set", schema, key, value], check=False).returncode != 0:
        failed.append(ident)
if failed:
    print("✗ 以下 GNOME 键位还原失败：" + "、".join(failed), file=sys.stderr)
    sys.exit(1)
print(f"已还原 {len(backup)} 条 GNOME 键位")
PY
    if [[ $rc -ne 0 ]]; then
        err "GNOME 键位还原失败，备份保留在 $BACKUP"
        return 1
    fi
    # 还原成功后清掉备份：否则下一次 apply 会沿用「首次安装前」的旧值，
    # 期间用户自己改过的 GNOME 快捷键会在 revert 时被旧值盖回去。
    rm -f "$BACKUP"
    ok "GNOME 键位还原完成（备份已清除）"
    return 0
}

cmd_generate() {
    guard_forwarded_paths "$@"
    python3 "$ROOT/tools/generate.py" \
        --user-config "$CONF_DIR/config.json" --out-dir "$CONF_DIR" --backup "$BACKUP" "$@"
}

cmd_test() {
    local rc=0
    echo "── 1/3 离线单元测试（focusd + 生成器 + 引擎下载 + 卸载清理 + 安装幂等，不连 D-Bus、不注入按键）──"
    python3 "$ROOT/tests/test_focusd.py" || rc=1
    python3 "$ROOT/tests/test_generate.py" || rc=1
    python3 "$ROOT/tests/test_fetch_engine.py" || rc=1
    bash "$ROOT/tests/test-uninstall-cleanup.sh" || rc=1
    bash "$ROOT/tests/test-install-idempotency.sh" || rc=1
    echo
    echo "── 2/3 扩展契约（隔离带：加载真实 extension.js，走真实 D-Bus 往返）──"
    bash "$ROOT/tests/verify-extension.sh" || rc=1
    echo
    echo "── 3/3 端到端：焦点桥 → 按应用分流 + 替换模式例外 ──"
    local engine; engine="$(find_engine)" \
        || die "找不到可执行的 xremap 引擎；先 mackey fetch-engine 或设置 MACKEY_ENGINE=/path/to/xremap"
    MACKEY_ENGINE="$engine" bash "$ROOT/tests/e2e-app-match.sh" || rc=1
    MACKEY_ENGINE="$engine" bash "$ROOT/tests/e2e-swallow-exempt.sh" || rc=1
    return $rc
}

cmd_logs() {
    session_env
    journalctl --user -u mackey-engine -u mackey-focusd -n "${1:-50}" --no-pager
}

cmd_version() {
    local ver="未知"
    [[ -f "$ROOT/VERSION" ]] && ver="$(head -n 1 "$ROOT/VERSION" | tr -d '[:space:]')"
    printf 'mackey %s\n' "$ver"
    local engine; engine="$(find_engine || true)"
    if [[ -n "$engine" ]]; then
        printf '引擎   %s\n' "$("$engine" --version 2>&1 | head -n 1)"
    fi
}

usage() {
    cat <<EOF
${C_DIM}Mackey${C_END} —— GNOME 上的 macOS 键位模拟（不写系统目录 / 不破坏 GNOME 功能）

用法: mackey <命令>

  init        生成 ${XDG_CONFIG_HOME:-~/.config}/mackey/config.json（自动判定键盘配列）
  fetch-engine 下载与指令集架构/桌面匹配的 xremap 最新发布版本（存到 XDG 数据目录）
  install     安装扩展、systemd 用户服务与命令行入口（默认同时下载引擎；--no-fetch 跳过下载，--keep-running 不停旧服务）
  enable      启动服务并启用扩展
  disable     停用（键盘立刻回到 Linux 原生行为）
  status      当前状态一览
  doctor      体检：权限 / 引擎 / 扩展 / 焦点桥 / 冲突 / 历史遗留
  probe       打印 GNOME 已占用键位与需要迁移的项（只读）
  generate    重新生成 xremap 配置、迁移计划与行为清单
  apply       生成 + 迁移冲突键位（带备份）+ 重启服务
  revert      还原 GNOME 键位（卸载时自动调用）
  test        三套自测（离线单元 / 扩展契约 / 端到端；端到端只用虚拟键盘，透传的键会到焦点窗口）
  logs [n]    看服务日志
  version     显示版本与引擎路径
  uninstall   卸载并还原（--purge 连配置/缓存一起清理；--dry-run 只列清单；--yes 免确认）

环境变量:
  MACKEY_YES=1            跳过确认
  MACKEY_ENGINE=...       指定引擎二进制（覆盖自动查找）
  MACKEY_ENGINE_TAG=...   指定 fetch-engine 下载的发布标签（默认 latest）
EOF
}

case "${1:-}" in
    ""|-h|--help|help) usage; exit 0 ;;
esac

# 立身之本：不碰系统目录、不碰 root 的 HOME。所有子命令统一在入口拒绝 root。
guard_no_root

case "${1:-}" in
    init)      shift; cmd_init "$@" ;;
    fetch-engine) shift; cmd_fetch_engine "$@" ;;
    install)   shift; cmd_install "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    enable)    shift; cmd_enable "$@" ;;
    disable)   shift; cmd_disable "$@" ;;
    status)    shift; cmd_status "$@" ;;
    doctor)    shift; cmd_doctor "$@" ;;
    probe)     shift; cmd_probe "$@" ;;
    generate)  shift; cmd_generate "$@" ;;
    apply)     shift; cmd_apply "$@" ;;
    revert)    shift; cmd_revert_gsettings "$@" ;;
    test)      shift; cmd_test "$@" ;;
    logs)      shift; cmd_logs "$@" ;;
    version|-V|--version) shift; cmd_version "$@" ;;
    *) usage; exit 1 ;;
esac

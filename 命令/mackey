#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# 源码树入口；安装后直接运行独立 Rust 二进制。
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$(id -u)" == 0 ]]; then
    echo '不要用 root/sudo 运行：本工具不碰系统目录' >&2
    exit 1
fi
if [[ -x "$ROOT/target/debug/mackey" ]]; then
    exec "$ROOT/target/debug/mackey" "$@"
fi
if [[ -x "$ROOT/target/release/mackey" ]]; then
    exec "$ROOT/target/release/mackey" "$@"
fi
exec cargo run --quiet --locked --manifest-path "$ROOT/Cargo.toml" --bin mackey -- "$@"
